---
import MarcaDojo from '../components/MarcaDojo.jsx';
import NavegacionInferior from '../components/NavegacionInferior.astro';
import ProtegerPagina from '../components/ProtegerPagina.astro';
import '../styles/global.css';
interface Props { title: string; active: string; backHref?: string; backLabel?: string; }
const { title, active, backHref, backLabel = 'Volver a clases' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/logo-dojo.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#c62828" />
    <meta name="color-scheme" content="light" />
    <title>{title} | Shinken Dojo - Hiroshi</title>
    <ProtegerPagina />
  </head>
  <body class="admin-body">
    <a class="app-skip-link" href="#contenido">Ir al contenido</a>
    <div class="admin-shell">
      <header class="app-header">
        <div class="app-header__row">
          {backHref && <a href={backHref} class="app-back" aria-label={backLabel} title={backLabel}>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
          </a>}
          <div class="app-header__title">
            <MarcaDojo compacta />
            <h1>{title}</h1>
          </div>
          <a href="/usuario" class="app-account" data-solo-perfiles hidden aria-label="Mi cuenta" title="Mi cuenta">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
          </a>
        </div>
      </header>
      <div id="contenido" class="admin-content" tabindex="-1"><slot /></div>
      <NavegacionInferior active={active} />
    </div>
  </body>
</html>
