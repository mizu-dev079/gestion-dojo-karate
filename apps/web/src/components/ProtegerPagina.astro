---
// Oculta la página hasta confirmar que hay sesión; si no la hay, redirige a /login.
// La protección real está en la API (responde 401); esto evita mostrar pantallas vacías.
---

<style is:global>
  html {
    visibility: hidden;
  }
</style>

<script>
  import { API_URL } from "../lib/api.js";
  import { enlaceCuentaAdmin, origenCuentaAdmin } from "../lib/navegacionAdmin.js";
  import { enlaceCuenta, origenCuenta } from "../lib/navegacionPerfil.js";

  const mostrar = () => {
    document.documentElement.style.visibility = "visible";
  };

  const irAlLogin = () => {
    const volver = window.location.pathname + window.location.search;
    window.location.replace(`/login?volver=${encodeURIComponent(volver)}`);
  };

  fetch(`${API_URL}/auth/me`, { credentials: "include", cache: "no-store" })
    .then(async (respuesta) => {
      if (!respuesta.ok) { irAlLogin(); return; }
      const sesion = await respuesta.json();
      if (!['administrador','profesor','alumno'].includes(sesion.perfil)) { irAlLogin(); return; }
      const compartidas = ['/alumnos','/usuario','/ajustes','/calendario'];
      if (sesion.perfil !== 'administrador' && !compartidas.includes(window.location.pathname.replace(/\/$/, ''))) {
        window.location.replace('/alumnos'); return;
      }
      window.dojoSesion = sesion;
      document.documentElement.dataset.perfil = sesion.perfil;
      const actualizarCabecera = () => {
      const esPerfil = sesion.perfil !== 'administrador';
      if (!esPerfil) {
        const ruta = window.location.pathname.replace(/\/$/, "");
        const cuenta = document.querySelector<HTMLAnchorElement>(".app-account");
        if (cuenta) {
          cuenta.hidden = ruta === "/usuario";
          cuenta.href = enlaceCuentaAdmin(ruta === "/ajustes" ? origenCuentaAdmin(window.location.search) : ruta + window.location.search);
        }
        const atras = document.querySelector<HTMLAnchorElement>(".app-back");
        if (atras) {
          atras.hidden = ruta === "/clases";
          if (ruta === "/cuentas/alumnos" && origenCuentaAdmin(window.location.search).startsWith('/postulaciones')) {
            atras.href = origenCuentaAdmin(window.location.search);
            atras.title = "Volver a postulaciones";
            atras.setAttribute("aria-label", "Volver a postulaciones");
          }
          if (ruta === "/ajustes") {
            atras.href = enlaceCuentaAdmin(origenCuentaAdmin(window.location.search));
            atras.title = "Volver a mi cuenta";
            atras.setAttribute("aria-label", "Volver a mi cuenta");
          }
          if (ruta === "/usuario") {
            atras.href = origenCuentaAdmin(window.location.search);
            atras.title = "Volver";
            atras.setAttribute("aria-label", "Volver");
          }
        }
      }
      if (esPerfil) {
        const ruta = window.location.pathname.replace(/\/$/, '');
        const origen = ['/calendario', '/alumnos'].includes(ruta) ? ruta + window.location.search : origenCuenta(window.location.search);
        const cuenta = document.querySelector<HTMLAnchorElement>('.app-account');
        if (cuenta) {
          cuenta.href = enlaceCuenta(origen);
          cuenta.hidden = ruta === '/usuario';
        }
        const atras = document.querySelector<HTMLAnchorElement>('.app-back');
        if (atras) {
          atras.hidden = ruta === '/alumnos';
          const destino = ruta === '/usuario' ? origen : ruta === '/ajustes' ? enlaceCuenta(origen) : '/alumnos';
          const etiqueta = ruta === '/ajustes' ? 'Volver a mi cuenta' : destino.startsWith('/calendario') ? 'Volver a asistencia' : 'Volver a mis clases';
          atras.href = destino;
          atras.setAttribute('aria-label', etiqueta);
          atras.title = etiqueta;
        }
        const titulos: Record<string, string> = { '/alumnos': 'Mis clases', '/calendario': 'Asistencia', '/usuario': 'Mi cuenta' };
        const titulo = titulos[ruta];
        if (titulo) {
          const encabezado = document.querySelector('.app-header__title h1');
          if (encabezado) encabezado.textContent = titulo;
          document.title = `${titulo} | Shinken Dojo - Hiroshi`;
        }
      }
      };
      actualizarCabecera();
      window.addEventListener('popstate', actualizarCabecera);
      window.addEventListener('dojo:navegacion', actualizarCabecera);
      window.dispatchEvent(new Event('dojo:sesion'));
      mostrar();
    })
    .catch(irAlLogin);
</script>
