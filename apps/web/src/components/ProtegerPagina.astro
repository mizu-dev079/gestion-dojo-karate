---
// Oculta la página hasta confirmar que hay sesión; si no la hay, redirige a /login.
// La protección real está en la API (responde 401); esto evita mostrar pantallas vacías.
---

<style is:global>
  html {
    visibility: hidden;
  }
</style>

<script>
  import { API_URL } from "../lib/api.js";

  const mostrar = () => {
    document.documentElement.style.visibility = "visible";
  };

  const irAlLogin = () => {
    const volver = window.location.pathname + window.location.search;
    window.location.replace(`/login?volver=${encodeURIComponent(volver)}`);
  };

  fetch(`${API_URL}/auth/me`, { credentials: "include", cache: "no-store" })
    .then(async (respuesta) => {
      if (!respuesta.ok) { irAlLogin(); return; }
      const sesion = await respuesta.json();
      if (!['administrador','profesor','alumno'].includes(sesion.perfil)) { irAlLogin(); return; }
      const compartidas = ['/alumnos','/usuario','/ajustes','/calendario'];
      if (sesion.perfil !== 'administrador' && !compartidas.includes(window.location.pathname.replace(/\/$/, ''))) {
        window.location.replace('/alumnos'); return;
      }
      window.dojoSesion = sesion;
      document.documentElement.dataset.perfil = sesion.perfil;
      document.querySelectorAll('[data-solo-admin]').forEach((elemento) => { elemento.hidden = sesion.perfil !== 'administrador'; });
      if (sesion.perfil !== 'administrador') document.querySelectorAll('a.app-back[href="/clases"]').forEach((a) => a.setAttribute('href','/alumnos'));
      if (sesion.perfil === 'alumno') document.querySelectorAll('a[href="/alumnos"] .app-bottom-nav__label').forEach((elemento) => { elemento.textContent = 'Mis clases'; });
      if (sesion.perfil !== 'administrador') {
        document.querySelectorAll('a[href="/calendario"] .app-bottom-nav__label').forEach((el) => { el.textContent = 'Asistencia'; });
        document.querySelectorAll('a[href="/usuario"] .app-bottom-nav__label').forEach((el) => { el.textContent = 'Mi cuenta'; });
      }
      if (sesion.perfil !== 'administrador') {
        const ruta = window.location.pathname.replace(/\/$/, '');
        const titulos: Record<string, string> = { '/alumnos': sesion.perfil === 'alumno' ? 'Mis clases' : 'Mis alumnos', '/calendario': 'Asistencia', '/usuario': 'Mi cuenta' };
        const titulo = titulos[ruta];
        if (titulo) {
          const encabezado = document.querySelector('.app-header__title h1');
          if (encabezado) encabezado.textContent = titulo;
          document.title = `${titulo} | Shinken Dojo - Hiroshi`;
        }
      }
      window.dispatchEvent(new Event('dojo:sesion'));
      mostrar();
    })
    .catch(irAlLogin);
</script>
